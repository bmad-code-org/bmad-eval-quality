{
	"lockfile-age": {
		"lockfiles": ["package-lock.json", "website/package-lock.json"],
		"cache": "lockfile-age-cache.json"
	},
	"licences": {
		"lockfiles": ["package-lock.json", "website/package-lock.json"],
		"allowlist": [
			"MIT",
			"Apache-2.0",
			"ISC",
			"BSD-2-Clause",
			"BSD-3-Clause",
			"0BSD",
			"BlueOak-1.0.0",
			"CC0-1.0",
			"Python-2.0"
		],
		"policies": {
			"website/package-lock.json": {
				"label": "workspace policy: package allowlist + MPL-2.0",
				"reason": "website/package.json is private, website/ appears in no files entry, and npm pack carries none of it, so nothing in that graph is ever distributed. MPL-2.0 is file-level copyleft on the covered files themselves and binds a redistributor of those files; the documentation site ships as static HTML built from these tools.",
				"also": ["MPL-2.0"]
			}
		},
		"tolerances": [
			{
				"reason": "astro declares sharp in optionalDependencies, npm records an optional dependency in the lockfile whatever --omit says, and the site selects passthroughImageService, so the binaries are never loaded. Selecting the default image service again withdraws this and the gate fails.",
				"lockfiles": ["website/package-lock.json"],
				"prefix": "@img/sharp-",
				"license": "LGPL-3.0-or-later",
				"optional": true,
				"marker": {
					"file": "website/astro.config.mjs",
					"contains": "passthroughImageService"
				}
			}
		]
	},
	"dependency-direction": {
		"roots": [
			{
				"path": "src",
				"extensions": [".ts"]
			}
		],
		"layers": [
			{
				"name": "root",
				"match": "exact",
				"path": "src/index.ts",
				"label": "src/index.ts",
				"imports": ["application", "core-schemas"]
			},
			{
				"name": "core-schemas",
				"match": "prefix",
				"path": "src/core/schemas/",
				"label": "core/schemas",
				"imports": ["core-schemas", "core"],
				"externals": {
					"policy": "allow",
					"modules": ["zod"],
					"rule": "core/schemas may import the external module \"zod\" only"
				}
			},
			{
				"name": "core",
				"match": "prefix",
				"path": "src/core/",
				"label": "core/ (excluding core/schemas)",
				"imports": ["core", "core-schemas"],
				"externals": {
					"policy": "deny",
					"rule": "core/ (excluding core/schemas) may not import an external module or Node builtin"
				}
			},
			{
				"name": "ports",
				"match": "prefix",
				"path": "src/ports/",
				"label": "ports/",
				"imports": ["ports", "core-schemas"],
				"externals": {
					"policy": "deny",
					"rule": "ports/ may import core/schemas only; it declares shapes and may not import an external module or Node builtin"
				}
			},
			{
				"name": "application",
				"match": "prefix",
				"path": "src/application/",
				"label": "application/",
				"imports": ["application", "core", "core-schemas", "ports"]
			},
			{
				"name": "adapters",
				"match": "prefix",
				"path": "src/adapters/",
				"label": "adapters/",
				"imports": ["adapters", "ports", "core-schemas"]
			},
			{
				"name": "testing",
				"match": "prefix",
				"path": "src/testing/",
				"label": "testing/",
				"imports": ["testing", "ports", "core-schemas"],
				"externals": {
					"policy": "deny",
					"rule": "testing/ may import ports/ and core/schemas only; the published conformance suite may not import a test framework, an external module, or a Node builtin"
				}
			},
			{
				"name": "cli",
				"match": "prefix",
				"path": "src/cli/",
				"label": "cli/",
				"imports": ["cli", "application", "adapters"]
			}
		],
		"exemptions": [
			{
				"file": "src/core/canonical/digest.ts",
				"module": "node:crypto",
				"binding": "createHash",
				"rule": "src/core/canonical/digest.ts may import only the named binding \"createHash\" from node:crypto"
			}
		],
		"purity": {
			"layers": ["core", "core-schemas"],
			"awaitRule": "no AwaitExpression under core/; application/ is the only layer that awaits a port",
			"asyncFunctionRule": "no async function under core/; core stages are synchronous",
			"newDateRule": "no clock read under core/ (AD-1): new Date() is impurity",
			"members": [
				{
					"member": "Date.now",
					"rule": "no clock read under core/ (AD-1): Date.now is impurity"
				},
				{
					"member": "performance.now",
					"rule": "no clock read under core/ (AD-1): performance.now is impurity"
				},
				{
					"member": "performance.timeOrigin",
					"rule": "no clock read under core/ (AD-1): performance.timeOrigin is impurity"
				},
				{
					"member": "Math.random",
					"rule": "no randomness under core/ (AD-1): Math.random is impurity"
				},
				{
					"member": "crypto.randomUUID",
					"rule": "no randomness under core/ (AD-1): crypto.randomUUID is impurity"
				},
				{
					"member": "crypto.getRandomValues",
					"rule": "no randomness under core/ (AD-1): crypto.getRandomValues is impurity"
				},
				{
					"member": "crypto.randomBytes",
					"rule": "no randomness under core/ (AD-1): crypto.randomBytes is impurity"
				},
				{
					"member": "crypto.randomInt",
					"rule": "no randomness under core/ (AD-1): crypto.randomInt is impurity"
				},
				{
					"member": "crypto.randomFillSync",
					"rule": "no randomness under core/ (AD-1): crypto.randomFillSync is impurity"
				},
				{
					"member": "crypto.randomFill",
					"rule": "no randomness under core/ (AD-1): crypto.randomFill is impurity"
				},
				{
					"member": "crypto.webcrypto",
					"rule": "no randomness under core/ (AD-1): crypto.webcrypto is impurity"
				},
				{
					"member": "crypto.subtle",
					"rule": "no randomness under core/ (AD-1): crypto.subtle is impurity"
				}
			]
		},
		"commonjs": "forbid",
		"reportOnly": false
	},
	"package-boundary": {
		"paths": [
			{
				"path": "src",
				"extensions": [".ts"]
			},
			{
				"path": "schemas",
				"extensions": [".json"]
			},
			{
				"path": "corpus"
			}
		],
		"manifest": {
			"file": "package.json",
			"fields": ["description", "keywords", "scripts"]
		},
		"patterns": [
			{
				"name": "_bmad-output",
				"match": "_bmad-output",
				"reason": "a planning-artifact path"
			},
			{
				"name": "planning-artifact",
				"match": "planning[- ]artifact",
				"reason": "a planning-artifact path"
			},
			{
				"name": "implementation-artifact",
				"match": "implementation[- ]artifact",
				"reason": "a planning-artifact path"
			},
			{
				"name": "sprint-status",
				"match": "sprint[- ]status",
				"reason": "the epic-and-story format's tracking file"
			},
			{
				"name": "ARCHITECTURE-SPINE.md",
				"match": "ARCHITECTURE-SPINE\\.md",
				"reason": "a planning-artifact path the tarball does not carry"
			},
			{
				"name": "bmad",
				"match": "bmad",
				"flags": "i",
				"reason": "no module references BMad"
			},
			{
				"name": "TEA",
				"match": "\\bTEA\\b",
				"reason": "no module references TEA"
			},
			{
				"name": "story",
				"match": "\\bstor(y|ies)\\b",
				"flags": "i",
				"reason": "an epic or story format"
			},
			{
				"name": "epic",
				"match": "\\bepics?\\b",
				"flags": "i",
				"reason": "an epic or story format"
			},
			{
				"name": "AC n",
				"match": "\\bACs?[- ]\\d",
				"flags": "i",
				"reason": "an acceptance-criterion reference"
			},
			{
				"name": "Task n",
				"match": "\\bTasks?[- ]\\d",
				"flags": "i",
				"reason": "the same format's task numbering"
			},
			{
				"name": "Decision n",
				"match": "(?<!ADR-\\d{3} )\\bDecisions?[- ]\\d",
				"flags": "i",
				"reason": "a story-local decision number with no stable identity"
			}
		]
	},
	"field-ownership": {
		"paths": [
			{
				"path": "src",
				"extensions": [".ts"]
			}
		],
		"fields": ["parentDigest", "revisionCount"],
		"declarations": ["src/core/schemas/", "src/core/lineage/"],
		"writers": [
			"src/core/seal/seal.ts",
			"src/core/preflight/reduce.ts",
			"src/core/emit/emit.ts"
		],
		"helpers": ["reviseArtifact"]
	},
	"doc-invocations": {
		"pages": ["README.md", "docs"],
		"binary": [
			{
				"entry": "dist/cli/main.js",
				"spellings": [
					"npx -y eval-quality",
					"npx eval-quality",
					"eval-quality",
					"node dist/cli/main.js"
				],
				"installedPrefix": "node_modules/eval-quality/"
			},
			{
				"entry": "dist/gates/gates-cli.js",
				"spellings": [
					"npx -y eval-quality-gates",
					"npx eval-quality-gates",
					"eval-quality-gates",
					"node dist/gates/gates-cli.js"
				],
				"installedPrefix": "node_modules/eval-quality/"
			},
			{
				"entry": "examples/tutorials/agent/release-notes-agent.mjs",
				"spellings": ["node examples/tutorials/agent/release-notes-agent.mjs"]
			},
			{
				"entry": "examples/tutorials/skill/skill-runner.mjs",
				"spellings": ["node examples/tutorials/skill/skill-runner.mjs"]
			},
			{
				"entry": "examples/tutorials/tool-use/run-tool-calls.mjs",
				"spellings": ["node examples/tutorials/tool-use/run-tool-calls.mjs"]
			}
		],
		"sampleInput": "corpus/dev/compile-seal-example/contract.json"
	},
	"doc-counts": {
		"sources": {
			"corpusContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "PUBLISHED_CONTRACTS"
				}
			},
			"disciplineRuleContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "DISCIPLINE_RULE_CONTRACTS"
				}
			},
			"compilingContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "COMPILING_CONTRACTS"
				}
			},
			"failingByDesign": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "FAILING_BY_DESIGN"
				}
			},
			"capturingContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "CAPTURING_CONTRACTS"
				}
			},
			"resettingContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "RESETTING_CONTRACTS"
				}
			},
			"apiContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "API_CONTRACTS"
				}
			},
			"cliContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "CLI_CONTRACTS"
				}
			},
			"mcpContracts": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "MCP_CONTRACTS"
				}
			},
			"committedChains": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "COMMITTED_CHAINS"
				}
			},
			"referenceAdapters": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "REFERENCE_ADAPTERS",
					"take": "length"
				}
			},
			"barrelSchemaVersions": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "BARREL_SCHEMA_VERSIONS",
					"take": "length"
				}
			},
			"stampedVersions": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "STAMPED_VERSIONS",
					"take": "length"
				}
			},
			"comparedVersions": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "COMPARED_VERSIONS",
					"take": "length"
				}
			},
			"callerAssembledVersions": {
				"kind": "module",
				"from": {
					"module": "scripts/doc-count-sources.ts",
					"export": "CALLER_ASSEMBLED_VERSIONS",
					"take": "length"
				}
			},
			"interchangeArtifacts": {
				"kind": "module",
				"from": {
					"module": "src/core/schemas/artifact.ts",
					"export": "INTERCHANGE_ARTIFACT_KEYS",
					"take": "length"
				}
			},
			"publishedGates": {
				"kind": "module",
				"from": {
					"module": "scripts/gate-config.ts",
					"export": "GATE_NAMES",
					"take": "length"
				}
			},
			"lockfileWindowDays": {
				"kind": "module",
				"from": {
					"module": "scripts/gate-config.ts",
					"export": "LOCKFILE_WINDOW_DAYS_DEFAULT"
				}
			},
			"scannedLineBound": {
				"kind": "module",
				"from": {
					"module": "scripts/package-boundary.ts",
					"export": "MAX_SCANNED_LINE"
				}
			},
			"orderingWitness": {
				"kind": "module",
				"from": {
					"module": "scripts/check-dependency-direction.ts",
					"export": "ORDERING_WITNESS_VIOLATIONS"
				}
			},
			"publishedBinaries": {
				"kind": "json",
				"file": "package.json",
				"path": ["bin"],
				"take": "keys"
			},
			"conformanceCorpus": {
				"kind": "module",
				"from": {
					"module": "src/testing/conformance.ts",
					"export": "CONFORMANCE_OUTCOME_COUNTS",
					"path": ["corpus"]
				}
			},
			"conformanceClock": {
				"kind": "module",
				"from": {
					"module": "src/testing/conformance.ts",
					"export": "CONFORMANCE_OUTCOME_COUNTS",
					"path": ["clock"]
				}
			},
			"conformanceFileSystem": {
				"kind": "module",
				"from": {
					"module": "src/testing/conformance.ts",
					"export": "CONFORMANCE_OUTCOME_COUNTS",
					"path": ["file-system"]
				}
			},
			"conformanceEnvironmentProbe": {
				"kind": "module",
				"from": {
					"module": "src/testing/conformance.ts",
					"export": "CONFORMANCE_OUTCOME_COUNTS",
					"path": ["environment-probe"]
				}
			},
			"conformanceCommandProbe": {
				"kind": "module",
				"from": {
					"module": "src/testing/conformance.ts",
					"export": "CONFORMANCE_OUTCOME_COUNTS",
					"path": ["command-probe"]
				}
			},
			"conformanceMcpProbe": {
				"kind": "module",
				"from": {
					"module": "src/testing/conformance.ts",
					"export": "CONFORMANCE_OUTCOME_COUNTS",
					"path": ["mcp-probe"]
				}
			}
		},
		"entries": [
			{
				"file": "README.md",
				"claim": "the corpus contract total",
				"pattern": {
					"match": "you can read ([a-z-]+) real contracts and one compiled-and-sealed pair"
				},
				"counts": ["corpusContracts"]
			},
			{
				"file": "docs/explanation/what-ships.md",
				"claim": "the corpus contract total",
				"pattern": {
					"match": "a ([a-z-]+)-contract development corpus"
				},
				"counts": ["corpusContracts"]
			},
			{
				"file": "docs/explanation/what-ships.md",
				"claim": "the reference adapter count",
				"pattern": {
					"match": "([a-z-]+) reference adapters at `eval-quality/adapters`"
				},
				"counts": ["referenceAdapters"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the schema version count and the interchange artifact total",
				"pattern": {
					"match": "([A-Za-z-]+) of the ([a-z-]+) artifacts carry one"
				},
				"counts": ["barrelSchemaVersions", "interchangeArtifacts"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the count of artifacts with an in-package version reader",
				"pattern": {
					"match": "([A-Za-z-]+) have an in-package reader"
				},
				"counts": ["comparedVersions"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the count of artifacts this package stamps",
				"pattern": {
					"match": "([A-Za-z-]+) are stamped by this package"
				},
				"counts": ["stampedVersions"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the count of caller-assembled artifacts",
				"pattern": {
					"match": "([A-Za-z-]+) are assembled by the caller"
				},
				"counts": ["callerAssembledVersions"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the reference adapter count",
				"pattern": {
					"match": "ships ([a-z-]+) reference adapters"
				},
				"counts": ["referenceAdapters"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the corpus contract total",
				"pattern": {
					"match": "`corpus/dev/` ships ([a-z-]+) contracts under `contracts/`"
				},
				"counts": ["corpusContracts"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the compiling contract count",
				"pattern": {
					"match": "(?:^|(?<=[.]\\s))([A-Za-z-]+) contracts compile\\."
				},
				"counts": ["compilingContracts"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the failing-by-design contract count",
				"pattern": {
					"match": "(?<=[.]\\s)([A-Za-z-]+) fail by design:"
				},
				"counts": ["failingByDesign"]
			},
			{
				"file": "docs/reference/cli-commands.md",
				"claim": "the per-port conformance outcome counts",
				"pattern": {
					"match": "`corpus` (\\d+), `clock` (\\d+), `file-system` (\\d+), `environment-probe` (\\d+), `command-probe` (\\d+), `mcp-probe` (\\d+)"
				},
				"counts": [
					"conformanceCorpus",
					"conformanceClock",
					"conformanceFileSystem",
					"conformanceEnvironmentProbe",
					"conformanceCommandProbe",
					"conformanceMcpProbe"
				],
				"rendering": "digits"
			},
			{
				"file": "docs/how-to/author-behavioral-contracts.md",
				"claim": "the corpus contract total",
				"pattern": {
					"match": "`corpus/dev/contracts/` holds ([a-z-]+) contracts:"
				},
				"counts": ["corpusContracts"]
			},
			{
				"file": "docs/how-to/author-behavioral-contracts.md",
				"claim": "the compiling contract count",
				"pattern": {
					"match": "(?:^|(?<=[.]\\s))([A-Za-z-]+) compile, and [a-z-]+ fail by design\\."
				},
				"counts": ["compilingContracts"]
			},
			{
				"file": "docs/how-to/author-behavioral-contracts.md",
				"claim": "the failing-by-design contract count",
				"pattern": {
					"match": "compile, and ([a-z-]+) fail by design\\."
				},
				"counts": ["failingByDesign"]
			},
			{
				"file": "docs/how-to/evaluate-ai-feature-behavior.md",
				"claim": "the `api`-declaring contract count",
				"pattern": {
					"match": "([A-Za-z-]+) of the [a-z-]+ contracts in `corpus/dev/contracts/` declare an `api` interface"
				},
				"counts": ["apiContracts"]
			},
			{
				"file": "docs/how-to/evaluate-ai-feature-behavior.md",
				"claim": "the corpus contract total",
				"pattern": {
					"match": "of the ([a-z-]+) contracts in `corpus/dev/contracts/` declare an `api` interface"
				},
				"counts": ["corpusContracts"]
			},
			{
				"file": "docs/tutorials/getting-started.md",
				"claim": "the corpus contract total",
				"pattern": {
					"match": "The package ships ([a-z-]+) of them"
				},
				"counts": ["corpusContracts"]
			},
			{
				"file": "docs/how-to/evaluate-agent-behavior.md",
				"claim": "the `cli`-declaring contract count",
				"pattern": {
					"match": "ships ([a-z-]+) contracts describing a system behind a command"
				},
				"counts": ["cliContracts"]
			},
			{
				"file": "docs/how-to/evaluate-workflow-behavior.md",
				"claim": "the contract count carrying a captured binding",
				"pattern": {
					"match": "([A-Za-z-]+) contracts in `corpus/dev/contracts/` use a `\\{ captured \\}` binding"
				},
				"counts": ["capturingContracts"]
			},
			{
				"file": "docs/how-to/evaluate-workflow-behavior.md",
				"claim": "the contract count declaring a fixture reset",
				"pattern": {
					"match": "([A-Za-z-]+) contracts in `corpus/dev/contracts/` declare a `fixtureReset`"
