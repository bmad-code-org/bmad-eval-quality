# ===== SECURITY POLICIES =====
#
# npm resolves a project .npmrc from the local prefix and does not inherit it
# across directories, so `npm --prefix website ci` reads this file and never the
# repository root's. Without it the website install runs unpoliced:
# allow-git=all, allow-remote=all, min-release-age=null, save-exact=false.
# AD-25 binds the whole resolved graph, documentation site included, so these
# four keys must stay byte-identical to the root .npmrc.

# Block git-based dependencies from re-enabling scripts (npm 11.10+)
allow-git=none

# Block remote-tarball dependencies from re-enabling scripts (npm 11.10+)
allow-remote=none

# Skip packages published less than 7 days ago
min-release-age=7

# Pin new packages to exact versions rather than semver ranges
save-exact=true
