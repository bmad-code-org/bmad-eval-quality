{
  "behaviors": [
    {
      "description": "A changelog the agent cannot parse is refused.",
      "id": "B-001",
      "observableSuccessCriterion": "A run over a changelog carrying an unrecognised line exits non-zero.",
      "oracles": [
        "O-001"
      ],
      "requirementLinks": [
        {
          "id": "REQ-1",
          "scheme": "local"
        }
      ],
      "riskLinks": [
        {
          "id": "RISK-1",
          "scheme": "local-risk"
        }
      ],
      "severity": "critical"
    },
    {
      "description": "A summarized changelog is readable back.",
      "id": "B-002",
      "observableSuccessCriterion": "Showing the notes file written by a run returns the changelog that run was given, with one entry per line.",
      "oracles": [
        "O-002",
        "O-003",
        "O-004",
        "O-005"
      ],
      "requirementLinks": [
        {
          "id": "REQ-2",
          "scheme": "local"
        }
      ],
      "riskLinks": [],
      "severity": "material"
    }
  ],
