  "oracles": [
    {
      "check": {
        "op": "not",
        "operands": [
          {
            "op": "equality",
            "operands": [
              {
                "pointer": "/interactions/refuse/exit-code"
              },
              {
                "literal": 0
              }
            ]
          }
        ]
      },
      "commentary": "The one oracle B-001 declares, so it is the oracle a probe naming B-001 is matched against.",
      "direction": {
        "evidenceTargets": [
          "/interactions/refuse/exit-code"
        ],
        "negativeDomain": "A run over that changelog exiting zero.",
        "polarity": "expects-hold",
        "relation": "not",
        "scope": "The run given the changelog with an unrecognised line."
      },
      "id": "O-001",
      "polarity": "expects-hold"
    },
    {
      "check": {
        "op": "equality",
        "operands": [
          {
            "pointer": "/interactions/show/stdout/source"
          },
          {
            "pointer": "/interactions/summarize/call-inputs/option/input"
          }
        ]
      },
      "commentary": "Relates what the write was given to what an independent later read returned.",
      "direction": {
        "evidenceTargets": [
          "/interactions/show/stdout/source",
          "/interactions/summarize/call-inputs/option/input"
        ],
        "negativeDomain": "A show reporting a changelog other than the one the summarize was given.",
        "polarity": "expects-hold",
        "relation": "equality",
        "scope": "One summarize followed by a show of the file it wrote."
      },
      "id": "O-002",
      "polarity": "expects-hold"
    },
    {
      "check": {
        "collection": {
          "pointer": "/interactions/show/stdout/entries"
        },
        "op": "for-all",
        "predicate": {
          "op": "existence",
          "operands": [
            {
              "pointer": "@/description"
            }
          ]
        }
      },
      "commentary": null,
      "direction": {
        "evidenceTargets": [
          "/interactions/show/stdout/entries"
        ],
        "negativeDomain": "An entry carrying no description.",
        "polarity": "expects-hold",
        "relation": "for-all",
        "scope": "Every entry the show returned."
      },
      "id": "O-003",
      "polarity": "expects-hold"
    },
    {
      "check": {
        "op": "all",
        "operands": [
          {
            "op": "existence",
            "operands": [
              {
                "pointer": "/interactions/show/stdout/summary"
              }
            ]
          },
          {
            "op": "existence",
            "operands": [
              {
                "pointer": "/interactions/show/stdout/entries"
              }
            ]
          },
          {
            "op": "existence",
            "operands": [
              {
                "pointer": "/interactions/show/stdout/source"
              }
            ]
          }
        ]
      },
      "commentary": "Reads the read's whole declared body at one step, which is what the whole-body and success-indicator-separation rules ask for.",
      "direction": {
        "evidenceTargets": [
          "/interactions/show/stdout/summary",
          "/interactions/show/stdout/entries",
          "/interactions/show/stdout/source"
        ],
        "negativeDomain": "A show omitting the summary, the entries, or the source.",
        "polarity": "expects-hold",
        "relation": "all",
        "scope": "The whole body the show returned."
      },
      "id": "O-004",
      "polarity": "expects-hold"
    },
    {
      "check": {
        "op": "all",
        "operands": [
          {
            "op": "existence",
            "operands": [
              {
                "pointer": "/interactions/summarize/artifact/notes/summary"
              }
            ]
          },
          {
            "op": "existence",
            "operands": [
              {
                "pointer": "/interactions/summarize/artifact/notes/entries"
              }
            ]
          },
          {
            "op": "existence",
            "operands": [
              {
                "pointer": "/interactions/summarize/artifact/notes/source"
              }
            ]
          }
        ]
      },
      "commentary": "The same whole-body reading against the file the write produced, since the two operations declare their own descriptors.",
      "direction": {
        "evidenceTargets": [
          "/interactions/summarize/artifact/notes/summary",
          "/interactions/summarize/artifact/notes/entries",
          "/interactions/summarize/artifact/notes/source"
        ],
        "negativeDomain": "A notes file omitting the summary, the entries, or the source.",
        "polarity": "expects-hold",
        "relation": "all",
        "scope": "The whole notes file the summarize wrote."
      },
      "id": "O-005",
      "polarity": "expects-hold"
    }
  ],
