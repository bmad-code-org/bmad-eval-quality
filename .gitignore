# Dependencies
node_modules/

# Build outputs
dist/
build/
website/node_modules/
website/.astro/

# Environment and config
.env
.DS_Store

# Logs
*.log
npm-debug.log*

# Coverage
/coverage

# Python bytecode from scripts/spine-lint
__pycache__/
*.pyc

# VitePress
docs/.vitepress/cache
docs/.vitepress/dist

# BMAD installer state and module config (installer-managed dev tooling, not
# part of the published library).
_bmad/

# Local decision-log sidecars generated next to the planning docs; not published.
_bmad-output/**/.memlog.md

# Local-only scratch and notes files.
*.local.md

# Shareable HTML is build output. `npm run build:shareable` regenerates it from
# the planning markdown, and no workflow publishes it from the repository.
_bmad-output/shareable/

# Verbatim reviewer reports. The triage and reconcile records beside them carry
# the findings, the verification log, and the dispositions actually applied.
_bmad-output/**/reviews/review-*.md
_bmad-output/**/reviews/round-2-verbatim/

# Local agent tooling / installed skills (not part of the published library)
.claude/
.agent/
.agents/
_bmad-output/planning-artifacts/research/

# do not gitignore the following files
!/_bmad-output/shareable
