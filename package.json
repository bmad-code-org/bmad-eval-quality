{
  "name": "eval-quality",
  "version": "0.0.0",
  "description": "Compile disciplined Behavioral Evaluation Contracts and score their ability to catch known defects.",
  "author": "Murat Ozcan",
  "license": "Apache-2.0",
  "private": false,
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "type": "module",
  "keywords": [
    "eval",
    "evals",
    "evaluation",
    "agent",
    "agent-eval",
    "llm",
    "behavioral-contract",
    "oracle",
    "contract-strength",
    "testing",
    "ai"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "homepage": "https://github.com/bmad-code-org/bmad-eval-quality#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bmad-code-org/bmad-eval-quality.git"
  },
  "bugs": {
    "url": "https://github.com/bmad-code-org/bmad-eval-quality/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.20.0"
  },
  "scripts": {
    "prepare": "command -v husky >/dev/null 2>&1 && husky || exit 0",
    "build": "tsc -p tsconfig-build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "check:docs": "node scripts/check-docs.mjs",
    "lint:spine": "python3 scripts/spine-lint/lint_spine.py --workspace _bmad-output/planning-artifacts/architecture/architecture-eval-quality-2026-07-29 --registry-ad 5 --workspace-root . --fail-on high",
    "test:spine-lint": "uv run --with pytest pytest scripts/spine-lint/tests -q",
    "build:shareable": "node scripts/build-shareable.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate": "npm run typecheck && npm run lint && npm run check:docs && npm run lint:spine && npm run test",
    "prepack": "npm run clean && npm run build",
    "prepublishOnly": "node scripts/assert-publish-authorized.mjs"
  },
  "dependencies": {
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.5",
    "@types/node": "22.20.1",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "marked": "18.0.7",
    "typescript": "7.0.2",
    "vitest": "4.1.10"
  },
  "overrides": {
    "vite": "7.3.1"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  }
}
